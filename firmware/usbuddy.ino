/*
 * usbuddy
 * -------
 *
 * CH552G + SSD1306 128x32
 *
 *   P3.7 : D-
 *   P3.6 : D+
 *   P1.6 : SCL 
 *   P1.7 : SDA 
 *   P1.5 : LED : active low
 *
 * Commands:
 *   TEXT:hello      -> clears the screen, prints on line 0
 *   LINE1:hello     -> prints on line 1 (also LINE2:, LINE3:)
 *   CLEAR           -> clears the screen
 *   LED:r,g,b       -> any value > 0 turns LED on, all zero turns it off
 */

#include <stdlib.h>
#include <string.h>

#define LED_PIN  15
#define LED_ON   LOW    // active low
#define LED_OFF  HIGH

#define SCL_PIN  16
#define SDA_PIN  17

#define H_FLIP 1
#define V_FLIP 1

#define OLED_ADDR  0x78   // 0x3C << 1
#define OLED_COLS  128
#define OLED_PAGES 4      // 32 px / 8
#define CHAR_W     6      // 5 px glyph + 1 px gap
#define LINE_CHARS 21     // 128 / 6

