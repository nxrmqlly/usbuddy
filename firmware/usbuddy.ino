static void i2cStart(void) {
  digitalWrite(SDA_PIN, HIGH);
  digitalWrite(SCL_PIN, HIGH);
  digitalWrite(SDA_PIN, LOW);
  digitalWrite(SCL_PIN, LOW);
}

static void i2cStop(void) {
  digitalWrite(SDA_PIN, LOW);
  digitalWrite(SCL_PIN, HIGH);
  digitalWrite(SDA_PIN, HIGH);
}

static void i2cWrite(uint8_t b) {
  uint8_t i;
  for (i = 0; i < 8; i++) {
    digitalWrite(SDA_PIN, (b & 0x80) ? HIGH : LOW);
    digitalWrite(SCL_PIN, HIGH);
    digitalWrite(SCL_PIN, LOW);
    b <<= 1;
  }
  // 9th clock ack ignored
  digitalWrite(SDA_PIN, HIGH);
  digitalWrite(SCL_PIN, HIGH);
  digitalWrite(SCL_PIN, LOW);
}


static void oledCmd(uint8_t c) {
  i2cStart();
  i2cWrite(OLED_ADDR);
  i2cWrite(0x00);        // control byte: command
  i2cWrite(c);
  i2cStop();
}

static void oledSetPos(uint8_t page, uint8_t col) {
  oledCmd(0xB0 | (page & 0x07));
  oledCmd(0x00 | (col & 0x0F));
  oledCmd(0x10 | (col >> 4));
}

static void oledClear(void) {
  uint8_t p, c;
  for (p = 0; p < OLED_PAGES; p++) {
    oledSetPos(p, 0);
    i2cStart();
    i2cWrite(OLED_ADDR);
    i2cWrite(0x40);      // control byte: data
    for (c = 0; c < OLED_COLS; c++) i2cWrite(0x00);
    i2cStop();
  }
}

static void oledSetFlip(uint8_t h, uint8_t v) {
  oledCmd(h ? 0xA0 : 0xA1);   // segment remap  (horizontal flip)
  oledCmd(v ? 0xC0 : 0xC8);   // COM scan dir   (vertical flip)
}

static void oledInit(void) {
  pinMode(SCL_PIN, OUTPUT);
  pinMode(SDA_PIN, OUTPUT);
  digitalWrite(SCL_PIN, HIGH);
  digitalWrite(SDA_PIN, HIGH);
  delay(100);            // let the display power up

  oledCmd(0xAE);                         // display off
  oledCmd(0xD5); oledCmd(0x80);          // clock divide
  oledCmd(0xA8); oledCmd(0x1F);          // multiplex = 32 rows
  oledCmd(0xD3); oledCmd(0x00);          // display offset 0
  oledCmd(0x40);                         // start line 0
  oledCmd(0x8D); oledCmd(0x14);          // charge pump on
  oledCmd(0x20); oledCmd(0x02);          // page addressing mode
  oledSetFlip(H_FLIP, V_FLIP);           // orientation
  oledCmd(0xDA); oledCmd(0x02);          // COM pins (128x32)
  oledCmd(0x81); oledCmd(0x8F);          // contrast
  oledCmd(0xD9); oledCmd(0xF1);          // precharge
  oledCmd(0xDB); oledCmd(0x40);          // VCOMH
  oledCmd(0xA4);                         // follow RAM
  oledCmd(0xA6);                         // normal (not inverted)
  oledCmd(0xAF);                         // display on

  oledClear();
}

// draw a string on a text line (0..3); anything past 21 chars is cut off
static void oledPrint(uint8_t line, const char *s) {
  uint8_t n = 0, i;
  uint16_t base;
  char c;

  if (line >= OLED_PAGES) return;
  oledSetPos(line, 0);

  i2cStart();
  i2cWrite(OLED_ADDR);
  i2cWrite(0x40);
  while (*s && n < LINE_CHARS) {
    c = *s++;
    if (c < 32 || c > 126) c = '?';
    base = (uint16_t)(c - 32) * 5;
    for (i = 0; i < 5; i++) i2cWrite(font5x7[base + i]);
    i2cWrite(0x00);      // gap column
    n++;
  }
  i2cStop();
}

static char lineBuf[40];
static uint8_t lineIdx = 0;
static uint8_t hFlip = H_FLIP;
static uint8_t vFlip = V_FLIP;

static void handleCommand(char *cmd) {
  if (strncmp(cmd, "HFLIP:", 6) == 0) {
    hFlip = (cmd[6] == '1');
    oledSetFlip(hFlip, vFlip);
    oledClear();   // segment remap only affects newly written data

  } else if (strncmp(cmd, "VFLIP:", 6) == 0) {
    vFlip = (cmd[6] == '1');
    oledSetFlip(hFlip, vFlip);
    oledClear();

  } else if (strncmp(cmd, "TEXT:", 5) == 0) {
    oledClear();
    oledPrint(0, cmd + 5);

  } else if (strncmp(cmd, "LINE", 4) == 0 && cmd[4] >= '0' && cmd[4] <= '3' && cmd[5] == ':') {
    oledPrint(cmd[4] - '0', cmd + 6);

  } else if (strcmp(cmd, "CLEAR") == 0) {
    oledClear();

  } else if (strncmp(cmd, "LED:", 4) == 0) {
    // parse "r,g,b" by hand (sscanf is far too big for 16 KB flash)
    char *p = cmd + 4;
    uint8_t on = 0, i;
    for (i = 0; i < 3; i++) {
      if (atoi(p) > 0) on = 1;
      while (*p && *p != ',') p++;
      if (*p == ',') p++;
    }
    digitalWrite(LED_PIN, on ? LED_ON : LED_OFF);
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LED_OFF);

  oledInit();
  oledPrint(0, "*-^-^-* hello *-^-^-*");
  oledPrint(1, "-> ready.");
}

void loop() {
  while (USBSerial_available()) {
    char c = USBSerial_read();
    if (c == '\n' || lineIdx >= sizeof(lineBuf) - 1) {
      lineBuf[lineIdx] = '\0';
      lineIdx = 0;
      handleCommand(lineBuf);
    } else if (c != '\r') {
      lineBuf[lineIdx++] = c;
    }
  }
}
